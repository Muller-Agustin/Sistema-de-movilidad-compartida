@startuml casos-de-uso-administrador
title Casos de uso — Administrador

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam ArrowColor #7A8A99
skinparam ArrowThickness 1.3
skinparam actorStyle awesome
skinparam actor {
  BackgroundColor #34495E
  BorderColor #2C3E50
  FontColor #FFFFFF
  FontStyle bold
}
skinparam usecase {
  BorderThickness 1.3
  FontColor #1B2A38
  ArrowColor #7A8A99
}
skinparam rectangle {
  BackgroundColor #FAFBFC
  BorderColor #C7D0D9
  BorderThickness 1.2
  FontColor #2C3E50
  FontStyle bold
  RoundCorner 20
}
skinparam titleFontSize 20
skinparam titleFontColor #1B2A38
skinparam titleFontStyle bold

actor Administrador

rectangle "Sistema de movilidad compartida" {
  usecase "Registrar vehículo\n(RF11)" as UC31 #D6EAF8/AED6F1
  usecase "Registrar estación\n(RF15)" as UC32 #D6EAF8/AED6F1
  usecase "Definir tarifa\n(RF16)" as UC33 #D6EAF8/AED6F1
  usecase "Definir promoción\n(RF17)" as UC34 #D6EAF8/AED6F1
  usecase "Dar de alta personal\n(RF24)" as UC35 #D6EAF8/AED6F1
  usecase "Simular avance del tiempo\n(RF33)" as UC36 #FCF3CF/F7DC6F
  usecase "Detectar viajes perdidos\n(RF13)" as UC17 #EAEDED/D5D8DC

  usecase "Emitir reporte de viajes\npor usuario\n(RF25)" as UC37 #E8DAEF/C39BD3
  usecase "Emitir reporte de vehículos\ncon más fallas\n(RF26)" as UC38 #E8DAEF/C39BD3
  usecase "Emitir reporte de uso\npor estación\n(RF27)" as UC39 #E8DAEF/C39BD3
  usecase "Emitir reporte de reparaciones\n(RF28)" as UC40 #E8DAEF/C39BD3
  usecase "Exportar reporte a CSV\n(RF36)" as UC41 #FCF3CF/F7DC6F
}

Administrador --> UC31
Administrador --> UC32
Administrador --> UC33
Administrador --> UC34
Administrador --> UC35
Administrador --> UC36
Administrador --> UC37
Administrador --> UC38
Administrador --> UC39
Administrador --> UC40

UC36 ..> UC17 : <<include>>
UC41 ..> UC37 : <<extend>>
UC41 ..> UC38 : <<extend>>
UC41 ..> UC39 : <<extend>>
UC41 ..> UC40 : <<extend>>

legend right
  |Color|Grupo|
  |<#D6EAF8>| Administración |
  |<#E8DAEF>| Reportes |
  |<#EAEDED>| Caso incluido (include) |
  |<#FCF3CF>| Caso opcional (extend) |
endlegend
@enduml
