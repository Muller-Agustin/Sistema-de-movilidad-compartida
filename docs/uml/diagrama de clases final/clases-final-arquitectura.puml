@startuml clases-final-arquitectura
' Diagrama de clases final (arquitectura) - coincide con el código de /src
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #333333
}
hide empty members

title Diagrama de clases final - Arquitectura

package "VistaMain (interfaz Swing)" #EAF2FB {
  class Main {
    -{static} ARCHIVO_DATOS : String = "datos/sistema.dat"
    +{static} main(args : String[])
    -{static} cargarDatosIniciales(sistema : SistemaMovilidad)
  }
  class VentanaPrincipal {
    -administradorPantallas : CardLayout
    -agregarPantalla(nombre : String, pantalla : PanelBase)
    -cerrarSistema()
  }
  abstract class PanelBase {
    #sistema : SistemaMovilidad
    +{abstract} actualizar()
    #crearBoton(texto : String) : JButton
    #crearTabla(modelo : DefaultTableModel) : JTable
    #mostrarFormulario(titulo : String, etiquetas : String[], campos : JComponent[]) : boolean
    #mostrarError(mensaje : String)
  }
  class PanelInicio
  class PanelUsuarios
  class PanelViajes
  class PanelVehiculos
  class PanelEstaciones
  class PanelReportes
}

package "GeneralPersistencia" #EAF7EE {
  class SistemaMovilidad <<Serializable>> {
    -operadores : List<Operador>
    +registrarOperador(operador : Operador)
    +buscarOperador(legajo : String) : Operador
  }
  class GestorArchivos <<Fabricación pura / SRP>> {
    -rutaArchivo : String
    +existenDatos() : boolean
    +guardar(sistema : SistemaMovilidad)
    +cargar() : SistemaMovilidad
  }
}

package "Controladores (GRASP Controlador)" #FFF6E5 {
  class ControladorUsuarios {
    -usuarios : List<Usuario>
    +registrarUsuario(usuario : Usuario)
    +buscarUsuario(documento : String) : Usuario
    +agregarMedioPago(usuario : Usuario, medio : MedioPago)
    +recargarSaldo(usuario : Usuario, importe : double, medio : MedioPago)
    +suscribirPlan(usuario : Usuario)
  }
  class ControladorViajes {
    -tarifas : List<Tarifa>
    -promociones : List<Promocion>
    -viajes : List<Viaje>
    -proximoNumeroViaje : int
    +agregarTarifa(tarifa : Tarifa)
    +buscarTarifaVigente(tipo : TipoVehiculo, fecha : LocalDate) : Tarifa
    +agregarPromocion(promocion : Promocion)
    +retirar(usuario : Usuario, vehiculo : Vehiculo, estacion : Estacion) : Viaje
    +devolver(usuario : Usuario, estacion : Estacion) : double
    +registrarPunto(viaje : Viaje, coordenada : Coordenada)
    +cancelar(viaje : Viaje)
    +detectarViajesPerdidos() : List<Viaje>
    +registrarAjuste(viaje : Viaje, operador : Operador, importe : double, motivo : String) : NotaAjuste
    +contarViajesPorEstacion(estacion : Estacion) : int
    +listarViajesEnCurso() : List<Viaje>
  }
  class ControladorMantenimiento {
    -vehiculos : List<Vehiculo>
    -tecnicos : List<Tecnico>
    -ordenes : List<OrdenMantenimiento>
    +registrarVehiculo(vehiculo : Vehiculo, estacion : Estacion)
    +buscarVehiculo(codigo : String) : Vehiculo
    +listarVehiculos() : List<Vehiculo>
    +listarVehiculosPorEstado(estado : EstadoVehiculo) : List<Vehiculo>
    +listarVehiculosConMasFallas() : List<Vehiculo>
    +cambiarEstado(vehiculo : Vehiculo, nuevoEstado : EstadoVehiculo)
    +recargarBateria(vehiculo : Vehiculo)
    +registrarTecnico(tecnico : Tecnico)
    +reportarFalla(autor : Reportante, vehiculo : Vehiculo, descripcion : String) : ReporteFalla
    +generarOrden(operador : Operador, vehiculo : Vehiculo, tecnico : Tecnico) : OrdenMantenimiento
    +tecnicoConMenosOrdenes() : Tecnico
    +cerrarOrden(orden : OrdenMantenimiento, tareas : List<String>, repuestos : List<String>)
    +listarOrdenesAbiertas() : List<OrdenMantenimiento>
  }
  class ControladorEstaciones {
    -estaciones : List<Estacion>
    -traslados : List<Traslado>
    +registrarEstacion(estacion : Estacion)
    +buscarEstacion(codigo : String) : Estacion
    +listarAlertas() : List<AlertaRedistribucion>
    +redistribuir(operador : Operador, origen : Estacion, destino : Estacion, vehiculos : List<Vehiculo>) : Traslado
  }
}

package "Dominio (ver diagrama de dominio)" #F3EDF9 {
  class Usuario
  class Viaje
  class Tarifa
  abstract class Promocion
  abstract class Vehiculo
  class OrdenMantenimiento
  class Estacion
  class Traslado
  class Operador
  class Tecnico
}

package "Excepciones (extienden Exception)" #FDECEC {
  class RetiroNoPermitidoExcepcion
  class VehiculoNoDisponibleExcepcion
  class EstacionLlenaExcepcion
  class SaldoInsuficienteExcepcion
  class OrdenIncompletaExcepcion
}

' ===== Vista =====
Main ..> GestorArchivos : carga
Main ..> VentanaPrincipal : abre
VentanaPrincipal "1" *-- "6" PanelBase
VentanaPrincipal --> GestorArchivos : guarda al cerrar
PanelBase <|-- PanelInicio