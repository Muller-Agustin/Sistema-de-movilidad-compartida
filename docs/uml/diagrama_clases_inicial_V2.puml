@startuml diagrama_clases_inicial
!pragma layout elk
' ============================================================
'  TPO POO - Propuesta C: Sistema de movilidad compartida
'  Diagrama de clases INICIAL (sin aplicar SOLID ni GRASP)
'  Se omiten getters y setters triviales.
'
'  Usa el motor de acomodo ELK (incluido en PlantUML reciente).
'  Si tu versión da error con la línea "!pragma layout elk",
'  borrala y PlantUML lo acomoda con Graphviz.
' ============================================================

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 60
skinparam ranksep 70
skinparam class {
  BackgroundColor White
  BorderColor #333333
  ArrowColor #333333
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #BBBBBB
}

title Sistema de movilidad compartida — Diagrama de clases inicial


package "usuarios" {
  class Usuario {
    -nombre : String
    -documento : String
    -email : String
    -fechaAlta : LocalDate
    -estado : EstadoUsuario
    +Usuario(nombre : String, documento : String, email : String)
    +puedeRetirar(saldoMinimo : double) : boolean
    +tieneViajeEnCurso() : boolean
    +estaHabilitado() : boolean
    +esPrimerViaje() : boolean
    +iniciarViaje(v : Vehiculo, e : Estacion, t : Tarifa) : Viaje
    +finalizarViaje(e : Estacion, promos : List<Promocion>) : void
    +suscribirPlan(plan : PlanMensual) : void
    +inhabilitar() : void
    +regularizar() : void
    +reportarFalla(v : Vehiculo, descripcion : String) : ReporteFalla
    +getIdentificacion() : String
  }

  class Cuenta {
    -saldo : double
    +Cuenta()
    +recargar(importe : double, medio : MedioPago) : void
    +debitar(importe : double, concepto : String) : void
    +agregarMedioPago(medio : MedioPago) : void
    +tieneSaldoSuficiente(minimo : double) : boolean
    +tieneSaldoNegativo() : boolean
    +aplicarAjuste(importe : double, credito : boolean) : Ajuste
  }

  class PlanMensual {
    -fechaInicio : LocalDate
    -fechaFin : LocalDate
    -precio : double
    -viajesIncluidos : int
    -viajesUtilizados : int
    +PlanMensual(fechaInicio : LocalDate, precio : double)
    +estaVigente(fecha : LocalDate) : boolean
    +tieneViajesDisponibles() : boolean
    +registrarViajeUsado() : void
  }

  abstract class Movimiento {
    -fecha : LocalDateTime
    -importe : double
    #Movimiento(importe : double)
    {abstract} +getImporteConSigno() : double
    {abstract} +getDescripcion() : String
  }

  class Debito {
    -concepto : String
    +Debito(importe : double, concepto : String)
    +getImporteConSigno() : double
    +getDescripcion() : String
  }

  class Recarga {
    +Recarga(importe : double, medio : MedioPago)
    +getImporteConSigno() : double
    +getDescripcion() : String
  }

  class Ajuste {
    -esCredito : boolean
    +Ajuste(importe : double, esCredito : boolean)
    +getImporteConSigno() : double
    +getDescripcion() : String
  }

  abstract class MedioPago {
    -titular : String
    -activo : boolean
    #MedioPago(titular : String)
    {abstract} +autorizar(importe : double) : boolean
    {abstract} +getDescripcion() : String
    +desactivar() : void
  }

  class Tarjeta {
    -ultimosDigitos : String
    -fechaVencimiento : LocalDate
    +Tarjeta(titular : String, ultimosDigitos : String, vencimiento : LocalDate)
    +estaVencida() : boolean
    +autorizar(importe : double) : boolean
    +getDescripcion() : String
  }

  class BilleteraVirtual {
    -proveedor : String
    -alias : String
    +BilleteraVirtual(titular : String, proveedor : String, alias : String)
    +autorizar(importe : double) : boolean
    +getDescripcion() : String
  }

  enum EstadoUsuario {
    HABILITADO
    INHABILITADO
  }

}

package "viajes" {
  class Viaje {
    {static} -MINUTOS_CANCELACION : int = 2
    {static} -MINUTOS_EXTRA_ESTACION_LLENA : int = 10
    {static} -HORAS_PERDIDA : int = 24
    -numero : int
    -inicio : LocalDateTime
    -fin : LocalDateTime
    -distanciaKm : double
    -estado : EstadoViaje
    -minutosSinCargo : int
    -importeFinal : double
    +Viaje(numero : int, u : Usuario, v : Vehiculo, retiro : Estacion, t : Tarifa)
    +registrarPunto(c : Coordenada, hora : LocalDateTime) : void
    +otorgarMinutosExtra() : void
    +finalizar(devolucion : Estacion, fin : LocalDateTime) : void
    +cancelar(ahora : LocalDateTime) : void
    +marcarPerdido() : void
    +getDuracionMinutos() : long
    +superaLimitePerdida(ahora : LocalDateTime) : boolean
    +aplicarMejorPromocion(promos : List<Promocion>) : void
    +calcularImporte() : double
    +estaEnCurso() : boolean
    +agregarNotaAjuste(n : NotaAjuste) : void
  }

  class NotaAjuste {
    -fecha : LocalDateTime
    -motivo : String
    -importeAjuste : double
    -esCredito : boolean
    +NotaAjuste(v : Viaje, autor : Operador, motivo : String, importe : double, credito : boolean)
  }

  class Tarifa {
    {static} -MINUTOS_SIN_RECARGO : int = 120
    {static} -RECARGO_EXCEDENTE : double = 0.5
    {static} -MINUTOS_SALDO_MINIMO : int = 30
    -tipoVehiculo : TipoVehiculo
    -vigenteDesde : LocalDate
    -cargoDesbloqueo : double
    -precioPorMinuto : double
    -cargoPorPerdida : double
    +Tarifa(tipo : TipoVehiculo, desde : LocalDate, desbloqueo : double, porMinuto : double, perdida : double)
    +calcularCosto(minutos : long) : double
    +calcularSaldoMinimo() : double
    +estaVigente(fecha : LocalDate) : boolean
  }

  class Promocion {
    -nombre : String
    -tipo : TipoPromocion
    -fechaInicio : LocalDate
    -fechaFin : LocalDate
    -minutosBonificados : int
    -porcentajeDescuento : double
    +Promocion(nombre : String, tipo : TipoPromocion, inicio : LocalDate, fin : LocalDate)
    +estaVigente(fecha : LocalDate) : boolean
    +esAplicable(v : Viaje) : boolean
    +calcularDescuento(v : Viaje) : double
  }

  class PuntoRecorrido {
    -fechaHora : LocalDateTime
    +PuntoRecorrido(c : Coordenada, fechaHora : LocalDateTime)
  }

  enum EstadoViaje {
    EN_CURSO
    FINALIZADO
    CANCELADO
    PERDIDO
  }

  enum TipoPromocion {
    PRIMER_VIAJE
    PLAN_MENSUAL
    ESTACION_BAJA_OCUPACION
  }

}

package "estaciones" {
  note "Clase inmutable: atributos final,\nsin setters. La usan Estacion\ny PuntoRecorrido." as NotaCoordenada
  class Estacion {
    {static} -OCUPACION_MINIMA : double = 0.20
    {static} -OCUPACION_MAXIMA : double = 0.90
    -codigo : String
    -direccion : String
    -capacidadMaxima : int
    +Estacion(codigo : String, direccion : String, ubicacion : Coordenada, capacidad : int)
    +estaLlena() : boolean
    +getPorcentajeOcupacion() : double
    +requiereRedistribucion() : boolean
    +generarAlerta() : AlertaRedistribucion
    +recibirVehiculo(v : Vehiculo) : void
    +liberarVehiculo(v : Vehiculo) : void
    +getVehiculosDisponibles() : List<Vehiculo>
    +distanciaA(otra : Estacion) : double
  }

  class Coordenada <<final>> {
    -latitud : double
    -longitud : double
    +Coordenada(latitud : double, longitud : double)
    +distanciaA(otra : Coordenada) : double
  }

  class AlertaRedistribucion {
    -fechaHora : LocalDateTime
    -tipo : TipoAlerta
    -estado : EstadoAlerta
    -porcentajeOcupacion : double
    +AlertaRedistribucion(e : Estacion, tipo : TipoAlerta, ocupacion : double)
    +atender() : void
    +estaPendiente() : boolean
  }

  class Traslado {
    -fechaHora : LocalDateTime
    +Traslado(origen : Estacion, destino : Estacion, responsable : Operador)
    +agregarVehiculo(v : Vehiculo) : void
    +ejecutar() : void
    +getCantidadVehiculos() : int
  }

  enum TipoAlerta {
    ESTACION_VACIA
    ESTACION_SATURADA
  }

  enum EstadoAlerta {
    PENDIENTE
    ATENDIDA
  }

}

package "vehiculos" {
  note "Un vehículo está en una estación\no en un viaje en curso, nunca en\nambos ni en ninguno (RN12)." as NotaVehiculo
  abstract class Vehiculo {
    {static} -MAX_FALLAS : int = 3
    {static} -DIAS_CONTROL_FALLAS : int = 30
    -codigo : String
    -fechaAlta : LocalDate
    -kmRecorridos : double
    -estado : EstadoVehiculo
    #Vehiculo(codigo : String, fechaAlta : LocalDate)
    {abstract} +getTipo() : TipoVehiculo
    +puedeRetirarse() : boolean
    +marcarEnUso() : void
    +marcarDisponible() : void
    +enviarAReparacion() : void
    +darDeBaja() : void
    #setEstado(estado : EstadoVehiculo) : void
    +sumarKm(km : double) : void
    +agregarReporte(r : ReporteFalla) : void
    +contarFallasRecientes(hoy : LocalDate) : int
    +requiereMantenimientoObligatorio(hoy : LocalDate) : boolean
    +agregarOrden(o : OrdenMantenimiento) : void
    +getCantidadFallas() : int
    +getDescripcion() : String
  }

  abstract class VehiculoElectrico {
    {static} -BATERIA_MINIMA : int = 15
    -nivelBateria : int
    #VehiculoElectrico(codigo : String, fechaAlta : LocalDate, nivelBateria : int)
    +actualizarBateria(nivel : int) : void
    +recargarBateria() : void
    +tieneBateriaBaja() : boolean
    +puedeRetirarse() : boolean
    +marcarDisponible() : void
    +getDescripcion() : String
  }

  class BicicletaComun {
    -rodado : int
    +BicicletaComun(codigo : String, fechaAlta : LocalDate, rodado : int)
    +getTipo() : TipoVehiculo
    +getDescripcion() : String
  }

  class BicicletaElectrica {
    -autonomiaKm : double
    +BicicletaElectrica(codigo : String, fechaAlta : LocalDate, bateria : int, autonomiaKm : double)
    +getTipo() : TipoVehiculo
    +getDescripcion() : String
  }

  class Monopatin {
    -velocidadMaxima : double
    +Monopatin(codigo : String, fechaAlta : LocalDate, bateria : int, velocidadMaxima : double)
    +getTipo() : TipoVehiculo
    +getDescripcion() : String
  }

  enum EstadoVehiculo {
    DISPONIBLE
    EN_USO
    EN_REPARACION
    BATERIA_BAJA
    FUERA_DE_SERVICIO
  }

  enum TipoVehiculo {
    BICICLETA_COMUN
    BICICLETA_ELECTRICA
    MONOPATIN
  }

}

package "mantenimiento" {
  class OrdenMantenimiento {
    -numero : int
    -fechaApertura : LocalDate
    -fechaCierre : LocalDate
    -tareasRealizadas : List<String>
    -repuestosUtilizados : List<String>
    +OrdenMantenimiento(numero : int, v : Vehiculo, t : Tecnico, op : Operador)
    +agregarTarea(tarea : String) : void
    +agregarRepuesto(repuesto : String) : void
    +cerrar(fecha : LocalDate) : void
    +estaAbierta() : boolean
  }

  class ReporteFalla {
    -fecha : LocalDate
    -descripcion : String
    +ReporteFalla(v : Vehiculo, autor : Reportante, descripcion : String)
    +esReciente(hoy : LocalDate, dias : int) : boolean
  }

  interface Reportante <<interface>> {
    +reportarFalla(v : Vehiculo, descripcion : String) : ReporteFalla
    +getIdentificacion() : String
  }

}

package "personal" {
  abstract class Personal {
    -legajo : String
    -nombre : String
    -telefono : String
    #Personal(legajo : String, nombre : String, telefono : String)
    {abstract} +getRol() : String
  }

  class Administrador {
    +Administrador(legajo : String, nombre : String, telefono : String)
    +getRol() : String
    +definirTarifa(tipo : TipoVehiculo, desbloqueo : double, porMinuto : double) : Tarifa
    +crearPromocion(nombre : String, tipo : TipoPromocion, inicio : LocalDate, fin : LocalDate) : Promocion
    +emitirReporteViajesPorUsuario(usuarios : List<Usuario>) : String
    +emitirReporteUsoPorEstacion(estaciones : List<Estacion>, viajes : List<Viaje>) : String
    +emitirReporteVehiculosConMasFallas(vehiculos : List<Vehiculo>) : String
    +emitirReporteReparaciones(ordenes : List<OrdenMantenimiento>) : String
  }

  class Tecnico {
    +Tecnico(legajo : String, nombre : String, telefono : String)
    +getRol() : String
    +registrarTarea(o : OrdenMantenimiento, tarea : String) : void
    +cerrarOrden(o : OrdenMantenimiento, fecha : LocalDate) : void
    +asignarOrden(o : OrdenMantenimiento) : void
    +getOrdenesAbiertas() : List<OrdenMantenimiento>
    +getOrdenesCerradas() : List<OrdenMantenimiento>
    +contarOrdenesAbiertas() : int
  }

  class Operador {
    +Operador(legajo : String, nombre : String, telefono : String)
    +getRol() : String
    +generarOrden(v : Vehiculo, t : Tecnico, reportes : List<ReporteFalla>) : OrdenMantenimiento
    +realizarTraslado(origen : Estacion, destino : Estacion, vs : List<Vehiculo>) : Traslado
    +emitirNotaAjuste(v : Viaje, motivo : String, importe : double, credito : boolean) : NotaAjuste
    +atenderAlerta(a : AlertaRedistribucion) : void
    +reportarFalla(v : Vehiculo, descripcion : String) : ReporteFalla
    +getIdentificacion() : String
  }

}

' ============================================================
'  HERENCIA E INTERFACES
' ============================================================
Movimiento <|-- Debito
Movimiento <|-- Recarga
Movimiento <|-- Ajuste
MedioPago <|-- Tarjeta
MedioPago <|-- BilleteraVirtual
Vehiculo <|-- BicicletaComun
Vehiculo <|-- VehiculoElectrico
VehiculoElectrico <|-- BicicletaElectrica
VehiculoElectrico <|-- Monopatin
Personal <|-- Administrador
Personal <|-- Tecnico
Personal <|-- Operador
Usuario ..|> Reportante
Operador ..|> Reportante

' ============================================================
'  COMPOSICIONES
' ============================================================
Usuario "1" *--> "1" Cuenta : tiene
Usuario "1" *--> "0..1" PlanMensual : plan
Cuenta "1" *--> "0..*" Movimiento : movimientos
Viaje "1" *--> "0..*" PuntoRecorrido : recorrido
Viaje "1" *--> "0..*" NotaAjuste : ajustes
Estacion "1" *--> "1" Coordenada : ubicacion
PuntoRecorrido "1" *--> "1" Coordenada : posicion

' ============================================================
'  AGREGACIONES
' ============================================================
Estacion "0..1" o--> "0..*" Vehiculo : estacionados
Traslado "0..*" o--> "1..*" Vehiculo : vehiculosMovidos

' ============================================================
'  ASOCIACIONES
' ============================================================
Cuenta "1" --> "0..*" MedioPago : mediosPago
Recarga "0..*" --> "1" MedioPago : medio
Usuario "1" -- "0..*" Viaje : viajes
Viaje "0..*" --> "1" Vehiculo : vehiculo
Viaje "0..*" --> "1" Estacion : retiro
Viaje "0..*" --> "0..1" Estacion : devolucion
Viaje "0..*" --> "1" Tarifa : tarifaAplicada
Viaje "0..*" --> "0..1" Promocion : promocionAplicada
NotaAjuste "0..*" --> "1" Operador : autor
NotaAjuste "1" --> "1" Ajuste : movimiento
Estacion "1" -- "0..*" AlertaRedistribucion : alertas
Vehiculo "1" -- "0..*" ReporteFalla : reportes
ReporteFalla "0..*" --> "1" Reportante : reportadoPor
Vehiculo "1" -- "0..*" OrdenMantenimiento : ordenes
OrdenMantenimiento "0..1" --> "0..*" ReporteFalla : origen
OrdenMantenimiento "0..*" -- "1" Tecnico : asignadaA
OrdenMantenimiento "0..*" --> "1" Operador : generadaPor
Estacion "1" <-- "0..*" Traslado : origen
Estacion "1" <-- "0..*" Traslado : destino
Traslado "0..*" --> "1" Operador : responsable

' ============================================================
'  DEPENDENCIAS
' ============================================================
Tarifa <.. Administrador : <<crea>>
Promocion <.. Administrador : <<crea>>

' ============================================================
'  NOTAS
' ============================================================
Coordenada .. NotaCoordenada
Vehiculo .. NotaVehiculo


legend right
  Subrayado = static · Cursiva = abstracto
  Se omiten getters y setters triviales.
endlegend

@enduml
